# Server-only DeepSeek credential. Never expose this in NEXT_PUBLIC_* variables.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional shared access code for a public deployment.
QUALICODE_ACCESS_CODE=

# Best-effort in-memory protection for one running instance.
QUALICODE_MAX_REQUESTS_PER_WINDOW=6
QUALICODE_RATE_WINDOW_MS=600000
